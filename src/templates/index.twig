{% extends '_layouts/cp' %}

{% import '_includes/forms.twig' as forms %}

{% set title = 'Link Audit'|t('link-audit') %}
{% set selectedSubnavItem = 'overview' %}
{% set crumbs = [
    { label: 'Link Audit'|t('link-audit'), url: cpUrl('link-audit') },
    { label: 'Overview'|t('link-audit') },
] %}

{% if sites|length > 1 %}
    {% set crumbs = [{
        id: 'site-crumb',
        icon: 'world',
        label: site.name|t('site'),
        menu: { items: siteMenuItems(sites, site), label: 'Select site'|t('app') },
    }]|merge(crumbs) %}
{% endif %}

{% set tiles = [
    {
        label: 'Broken'|t('link-audit'),
        total: counts.broken,
        colour: 'red',
        url: cpUrl('link-audit/broken', { site: siteHandle }),
    },
    {
        label: 'Permanent Redirects'|t('link-audit'),
        total: counts.permanentRedirect,
        colour: 'blue',
        url: cpUrl('link-audit/redirects', { site: siteHandle, permanent: '1' }),
        info: 'The pages these links point at have moved for good, and your content still carries the old addresses. The links still work, but they are worth updating.'|t('link-audit'),
    },
    {
        label: 'Unverifiable'|t('link-audit'),
        total: counts.blocked,
        colour: 'yellow',
        url: cpUrl('link-audit/blocked', { site: siteHandle }),
        info: 'These refused an automated check. LinkedIn and sites behind Cloudflare are the usual ones. They are most likely grand in a real browser, so they are never counted as broken.'|t('link-audit'),
    },
    {
        label: 'No Answer'|t('link-audit'),
        total: counts.unreachable,
        colour: 'orange',
        url: cpUrl('link-audit/no-answer', { site: siteHandle }),
        info: 'These did not answer when last checked: a server that was down, or an address that would not resolve. They are retried on their own, and one that keeps failing is called Broken after a few failures in a row.'|t('link-audit'),
    },
    {
        label: 'Working'|t('link-audit'),
        total: counts.ok,
        colour: 'green',
        url: null,
    },
] %}

{% block actionButton %}
    {% if canRunScans %}
        <form method="post" accept-charset="UTF-8" class="flex" id="link-audit-scan-actions">
            {{ csrfInput() }}
            {{ actionInput('link-audit/scans/start') }}
            {{ redirectInput('link-audit?site=' ~ siteHandle) }}
            {{ forms.hidden({ name: 'siteId', value: siteId }) }}
            <button type="submit" class="btn" name="mode" value="incremental">
                <span class="label">{{ 'Scan what changed'|t('link-audit') }}</span>
                <div class="spinner spinner-absolute"></div>
            </button>
            <button type="submit" class="btn submit" name="mode" value="full">
                <span class="label">{{ 'Run full scan'|t('link-audit') }}</span>
                <div class="spinner spinner-absolute"></div>
            </button>
        </form>

        {% js %}
        (function() {
            'use strict';

            var form = document.getElementById('link-audit-scan-actions');

            if (!form) {
                return;
            }

            var busy = false;

            // The clicked button spins rather than being disabled: disabling it
            // before the request leaves would drop its name and value out of
            // the POST, and the mode travels on the button.
            form.addEventListener('submit', function(event) {
                if (busy) {
                    event.preventDefault();

                    return;
                }

                busy = true;

                if (event.submitter) {
                    event.submitter.classList.add('loading');
                    event.submitter.setAttribute('aria-busy', 'true');
                }
            });
        })();
        {% endjs %}
    {% endif %}
{% endblock %}

{% block content %}
    {% if runningScan %}
        {% css %}
        #link-audit-progress td[data-progress] { font-variant-numeric: tabular-nums; }
        #link-audit-progress th[scope="row"] { width: 220px; }
        #content #link-audit-progress,
        #link-audit-progress {
            --pane-bg: var(--notice-background);
            --pane-border: 1px solid var(--notice-border-color);
            --secondary-pane-bg: var(--notice-background);
            background-color: var(--notice-background);
            border: 1px solid var(--notice-border-color);
            border-inline-start: 4px solid var(--notice-color);
        }
        #link-audit-progress h2 { display: flex; align-items: center; gap: 10px; }
        /* The pane's blue tint sits behind an otherwise translucent button and
           muddies the label; an opaque base keeps the contrast. */
        #link-audit-cancel-scan .btn { background-color: var(--white); }
        #link-audit-cancel-scan .btn:hover { background-color: var(--gray-050); }
        #link-audit-cancel-scan { margin-top: var(--l); }
        {% endcss %}
        <div class="pane" id="link-audit-progress">
            <h2>
                {{ 'A scan is running'|t('link-audit') }}
                <span class="spinner" aria-hidden="true"></span>
            </h2>
            <p class="light">
                {{ 'It works through the content first, then the URLs. The counts below update as it goes.'|t('link-audit') }}
            </p>
            <table class="data fullwidth">
                <tbody aria-live="polite">
                    <tr>
                        <th scope="row">{{ 'Stage'|t('link-audit') }}</th>
                        <td data-progress="statusLabel">{{ runningScanStatus }}</td>
                    </tr>
                    <tr>
                        <th scope="row">{{ 'Content Items Read'|t('link-audit') }}</th>
                        <td data-progress="elementsScanned">{{ runningScan.elementsScanned }}</td>
                    </tr>
                    <tr>
                        <th scope="row">{{ 'URLs Checked'|t('link-audit') }}</th>
                        <td data-progress="urlsChecked">{{ runningScan.urlsChecked }}</td>
                    </tr>
                    <tr>
                        <th scope="row">{{ 'Broken So Far'|t('link-audit') }}</th>
                        <td data-progress="urlsBroken">{{ runningScan.urlsBroken }}</td>
                    </tr>
                </tbody>
            </table>
            {% if canRunScans %}
                <form method="post" accept-charset="UTF-8" id="link-audit-cancel-scan"
                      data-confirm="{{ 'Stop the scan? Everything it has already checked stays on the report, and the content it never reached is read by the next scan.'|t('link-audit') }}">
                    {{ csrfInput() }}
                    {{ actionInput('link-audit/scans/cancel') }}
                    {{ redirectInput('link-audit?site=' ~ siteHandle) }}
                    <button type="submit" class="btn">
                        <span class="label">{{ 'Stop this scan'|t('link-audit') }}</span>
                        <div class="spinner spinner-absolute"></div>
                    </button>
                </form>

                {% js %}
                (function() {
                    'use strict';

                    var form = document.getElementById('link-audit-cancel-scan');

                    if (!form) {
                        return;
                    }

                    // The sentence is translated on the server and carried on the
                    // form: a string only this one confirm uses has no business
                    // being registered with Craft.t() as well.
                    form.addEventListener('submit', function(event) {
                        if (!window.confirm(form.getAttribute('data-confirm'))) {
                            event.preventDefault();

                            return;
                        }

                        if (event.submitter) {
                            event.submitter.classList.add('loading');
                            event.submitter.setAttribute('aria-busy', 'true');
                        }
                    });
                })();
                {% endjs %}
            {% endif %}
        </div>

        {% js %}
        (function() {
            'use strict';

            var container = document.getElementById('link-audit-progress');

            if (!container) {
                return;
            }

            var endpoint = '{{ actionUrl('link-audit/scans/status')|e('js') }}';

            function paint(scan) {
                Object.keys(scan).forEach(function(key) {
                    var cell = container.querySelector('[data-progress="' + key + '"]');

                    if (cell) {
                        cell.textContent = scan[key];
                    }
                });
            }

            function poll() {
                fetch(endpoint, {
                    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin',
                }).then(function(response) {
                    return response.json();
                }).then(function(data) {
                    if (!data || !data.scan) {
                        window.location.reload();

                        return;
                    }

                    paint(data.scan);
                    window.setTimeout(poll, 5000);
                }).catch(function() {
                    // A failed poll is not worth an error notice: the scan is
                    // running in a worker either way, and the next tick may well
                    // answer. Give it a longer gap and try again.
                    window.setTimeout(poll, 15000);
                });
            }

            window.setTimeout(poll, 5000);
        })();
        {% endjs %}
    {% endif %}

    {% if latestScan is null and not runningScan %}
        <div class="zilch">
            <p>{{ 'Nothing has been scanned yet. Run a scan and every link in your content gets pulled out, checked once, and reported here.'|t('link-audit') }}</p>
        </div>
    {% else %}
        {% css %}
        .link-audit-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; }
        .link-audit-tiles .info { width: 1.25em; }
        .link-audit-tile {
            position: relative;
            background: var(--pane-bg, var(--white));
            border: 1px solid var(--border-hairline);
            border-radius: var(--large-border-radius);
        }
        .link-audit-tile > a, .link-audit-tile > .link-audit-tile-body { display: block; padding: var(--m) var(--l); }
        .link-audit-tile--linked:hover { border-color: var(--dark-hairline-color); }
        .link-audit-tile > a:hover { text-decoration: none; }
        .link-audit-tile-count { font-size: 28px; font-weight: 600; line-height: 1.3; font-variant-numeric: tabular-nums; }
        .link-audit-tile-count--red { color: var(--red-600); }
        .link-audit-tile-count--blue { color: var(--blue-600); }
        .link-audit-tile-count--yellow { color: var(--amber-600); }
        .link-audit-tile-count--orange { color: var(--orange-600); }
        .link-audit-tile-count--green { color: var(--teal-600); }
        .link-audit-tile > .info,
        .link-audit-tile > .infoicon-container { position: absolute; top: var(--m); inset-inline-end: var(--m); }
        #link-audit-last-scan th[scope="row"] { width: 220px; }
        #link-audit-worst { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: start; margin-block: 14px; }
        #link-audit-worst > .pane { margin-block: 0; }
        @media (max-width: 900px) { #link-audit-worst { grid-template-columns: 1fr; } }
        #link-audit-worst td.rightalign, #link-audit-last-scan td { font-variant-numeric: tabular-nums; }
        {% endcss %}
        <div class="link-audit-tiles">
            {% for tile in tiles %}
                {% set tileInner %}
                    <div class="link-audit-tile-count link-audit-tile-count--{{ tile.colour }}">{{ tile.total }}</div>
                    <div class="light">{{ tile.label }}</div>
                {% endset %}
                <div class="link-audit-tile {{ tile.url ? 'link-audit-tile--linked' }}">
                    {% if tile.url %}
                        <a href="{{ tile.url }}">{{ tileInner }}</a>
                    {% else %}
                        <div class="link-audit-tile-body">{{ tileInner }}</div>
                    {% endif %}
                    {% if tile.info is defined and tile.info %}
                        <span class="info">{{ tile.info }}</span>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        {% if whereToStart %}
            {% css %}
            #link-audit-start ol { list-style: none; margin: var(--s) 0 0 0; padding: 0; counter-reset: la-step; }
            #link-audit-start ol > li {
                counter-increment: la-step;
                display: flex;
                gap: var(--m);
                padding-block: var(--m);
                border-block-start: 1px solid var(--border-hairline);
            }
            #link-audit-start ol > li::before {
                content: counter(la-step);
                flex: none;
                display: flex;
                align-items: center;
                justify-content: center;
                width: 26px;
                height: 26px;
                border-radius: 50%;
                background-color: var(--gray-100);
                color: var(--text-color);
                font-weight: 600;
                font-variant-numeric: tabular-nums;
            }
            #link-audit-start .link-audit-start-body { flex: 1; min-width: 0; }
            #link-audit-start .link-audit-start-body > a:first-child { font-weight: 600; }
            #link-audit-start .link-audit-start-body > p { margin-block: 2px 0; }
            #link-audit-start table { margin-block-start: var(--s); }
            #link-audit-start table td { border-block-start: 1px solid var(--border-hairline); padding-block: var(--s); }
            #link-audit-start table td:first-child { overflow-wrap: anywhere; }
            #link-audit-start td.rightalign { font-variant-numeric: tabular-nums; white-space: nowrap; }
            #link-audit-start > p:last-child {
                margin-block: 0;
                padding-block-start: var(--m);
                border-block-start: 1px solid var(--border-hairline);
            }
            {% endcss %}
            <div class="pane" id="link-audit-start">
                <h2>{{ 'Where to start'|t('link-audit') }}</h2>
                <p class="light">
                    {{ 'There is no need to work through a list this size from the top. Start with these and it comes down quicker.'|t('link-audit') }}
                </p>
                <ol>
                    {% if whereToStart.internalBroken > 0 %}
                        <li>
                            <div class="link-audit-start-body">
                                <a href="{{ cpUrl('link-audit/broken', { site: siteHandle, internal: '1' }) }}">
                                    {{ '{count} broken links point at your own sites'|t('link-audit', { count: whereToStart.internalBroken }) }}</a>
                                <p class="light">{{ 'Those are yours to fix without waiting on anybody else, and every one has been confirmed by your own server.'|t('link-audit') }}</p>
                            </div>
                        </li>
                    {% endif %}
                    {% if whereToStart.topByPlaces|length %}
                        <li>
                            <div class="link-audit-start-body">
                                <a href="{{ cpUrl('link-audit/broken', { site: siteHandle }) }}">
                                    {{ 'Clear {total} places with {count} fixes'|t('link-audit', {
                                        count: whereToStart.topByPlaces|length,
                                        total: whereToStart.topByPlacesTotal,
                                    }) }}</a>
                                <p class="light">{{ 'The addresses below sit in the most places, so these few fixes clear more of the report than anything else on it.'|t('link-audit') }}</p>
                                <table class="data fullwidth">
                                    <tbody>
                                        {% for row in whereToStart.topByPlaces %}
                                            <tr>
                                                <td>
                                                    <a href="{{ cpUrl('link-audit/url', { hash: row.urlHash, site: siteHandle }) }}" translate="no">
                                                        {{ row.label|length > 70 ? row.label|slice(0, 69) ~ '…' : row.label }}
                                                    </a>
                                                </td>
                                                <td class="rightalign">{{ '{count, plural, one{# place} other{# places}}'|t('link-audit', { count: row.places }) }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </li>
                    {% endif %}
                    {% if whereToStart.recentlyBroken > 0 %}
                        <li>
                            <div class="link-audit-start-body">
                                <a href="{{ cpUrl('link-audit/broken', { site: siteHandle }) }}">
                                    {{ '{count} of the broken links were still working a week ago'|t('link-audit', { count: whereToStart.recentlyBroken }) }}</a>
                                <p class="light">{{ 'These broke recently, so whatever changed is still fresh in somebody\'s mind.'|t('link-audit') }}</p>
                            </div>
                        </li>
                    {% endif %}
                    {% if whereToStart.firstSeenBroken > 0 %}
                        <li>
                            <div class="link-audit-start-body">
                                <a href="{{ cpUrl('link-audit/broken', { site: siteHandle }) }}">
                                    {{ '{count} of the broken links were seen for the first time by the last scan'|t('link-audit', { count: whereToStart.firstSeenBroken }) }}</a>
                                <p class="light">{{ 'Brand new to the report, from content just added or a source just switched on, so the author is likely still about.'|t('link-audit') }}</p>
                            </div>
                        </li>
                    {% endif %}
                </ol>
                <p class="light">
                    {{ 'You can leave the rest for now: Unverifiable and the temporary redirects need nothing from you, and the permanent redirects will keep for a quieter week.'|t('link-audit') }}
                </p>
            </div>
        {% endif %}

        {% if latestScan %}
            {% set lastScanStopped = latestScan.status == 'cancelled' %}
            <div class="pane" id="link-audit-last-scan">
                <h2>{{ 'Last scan'|t('link-audit') }}</h2>
                {% if lastScanStopped %}
                    <p class="light">{{ 'This run was stopped before it finished. The counts cover what it got through.'|t('link-audit') }}</p>
                {% endif %}
                <table class="data fullwidth">
                    <tbody>
                        <tr>
                            <th scope="row">{{ lastScanStopped ? 'Stopped'|t('link-audit') : 'Finished'|t('link-audit') }}</th>
                            <td>
                                {% if latestScan.dateFinished %}
                                    {{ latestScan.dateFinished|datetime('short') }}
                                {% else %}
                                    {{ 'Unknown'|t('link-audit') }}
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'Kind'|t('link-audit') }}</th>
                            <td>{{ latestScanMode }}</td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'Took'|t('link-audit') }}</th>
                            <td>
                                {% if latestScan.durationSeconds is not null %}
                                    {{ latestScan.durationSeconds|duration }}
                                {% else %}
                                    {{ 'Unknown'|t('link-audit') }}
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'Content Items Read'|t('link-audit') }}</th>
                            <td>{{ latestScan.elementsScanned }}</td>
                        </tr>
                        <tr>
                            <th scope="row">{{ 'URLs Checked'|t('link-audit') }}</th>
                            <td>{{ latestScan.urlsChecked }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        {% endif %}
        <div id="link-audit-worst">
            <div class="pane">
                <h2>{{ 'Hosts giving the most trouble'|t('link-audit') }}</h2>
                {% if topHosts|length %}
                    <table class="data fullwidth">
                        <thead>
                            <tr>
                                <th scope="col">{{ 'Host'|t('link-audit') }}</th>
                                <th scope="col" class="rightalign">{{ 'Broken Links'|t('link-audit') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for host in topHosts %}
                                <tr>
                                    <td>
                                        <a href="{{ cpUrl('link-audit/broken', { site: siteHandle, host: host.host }) }}" translate="no">
                                            {{ host.host }}
                                        </a>
                                    </td>
                                    <td class="rightalign">{{ host.total }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p class="light">{{ 'Nothing broken on this site, so no host is to blame.'|t('link-audit') }}</p>
                {% endif %}
            </div>

            <div class="pane">
                <h2>{{ 'Pages carrying the most broken links'|t('link-audit') }}</h2>
                {% if topPages|length %}
                    <table class="data fullwidth">
                        <thead>
                            <tr>
                                <th scope="col">{{ 'Page'|t('link-audit') }}</th>
                                <th scope="col" class="rightalign">{{ 'Broken Links'|t('link-audit') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for page in topPages %}
                                <tr>
                                    <td>
                                        {% if page.element %}
                                            {% set editUrl = page.element.getCpEditUrl() %}
                                            {% if editUrl %}
                                                <a href="{{ editUrl }}">{{ page.element.uiLabel }}</a>
                                            {% else %}
                                                {{ page.element.uiLabel }}
                                            {% endif %}
                                        {% else %}
                                            <span class="light">{{ 'Gone'|t('link-audit') }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="rightalign">{{ page.total }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p class="light">{{ 'No page on this site is carrying a broken link.'|t('link-audit') }}</p>
                {% endif %}
            </div>
        </div>

    {% endif %}
{% endblock %}
