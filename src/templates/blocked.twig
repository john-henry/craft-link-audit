{% extends '_layouts/cp' %}

{% set title = 'Unverifiable'|t('link-audit') %}
{% set selectedSubnavItem = 'blocked' %}
{% set crumbs = [
    { label: 'Link Audit'|t('link-audit'), url: cpUrl('link-audit') },
    { label: title },
] %}

{% if sites|length > 1 %}
    {% set crumbs = [{
        id: 'site-crumb',
        icon: 'world',
        label: site.name|t('site'),
        menu: { items: siteMenuItems(sites, site), label: 'Select site'|t('app') },
    }]|merge(crumbs) %}
{% endif %}

{% block content %}
    <p class="light">
        {{ 'These are not broken. The websites they point at refuse to answer anything but a person in a browser, so the checker cannot get an honest answer out of them. Plenty of big sites do this. There is usually nothing to fix here: open one in a new tab, and if the page comes up, leave the link alone.'|t('link-audit') }}
    </p>

    {% include 'link-audit/_includes/url-table' with {
        verdict: verdict,
        siteId: siteId,
        siteHandle: siteHandle,
        filters: filters,
        hostOptions: hostOptions,
        elementTypeOptions: elementTypeOptions,
        sourceOptions: sourceOptions,
        perPage: perPage,
        total: total,
        canRecheck: canRecheck,
        canIgnore: canIgnore,
        emptyMessage: 'Nothing on this site refused the checker.'|t('link-audit'),
    } only %}
{% endblock %}
