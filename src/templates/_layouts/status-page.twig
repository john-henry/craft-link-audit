{% extends '_layouts/cp' %}

{% set crumbs = [
    { label: 'Link Audit'|t('link-audit'), url: cpUrl('link-audit') },
    { label: title },
] %}

{% if sites|length > 1 %}
    {% set crumbs = [{
        id: 'site-crumb',
        icon: 'world',
        label: site.name|t('site'),
        menu: { items: siteMenuItems(sites, site), label: 'Select site'|t('app') },
    }]|merge(crumbs) %}
{% endif %}

{% block content %}
    <p class="light">
        {{ blurb }}
    </p>

    {% include 'link-audit/_includes/url-table' with {
        verdict: verdict,
        siteId: siteId,
        siteHandle: siteHandle,
        filters: filters,
        hostOptions: hostOptions,
        elementTypeOptions: elementTypeOptions,
        sourceOptions: sourceOptions,
        perPage: perPage,
        total: total,
        canRecheck: canRecheck,
        canIgnore: canIgnore,
        emptyMessage: emptyMessage,
    } only %}
{% endblock %}
