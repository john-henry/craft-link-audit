{% extends 'link-audit/_settings/layout' %}

{% import '_includes/forms.twig' as forms %}

{% block settingsFields %}
    {{ forms.editableTableField({
        label: 'Ignored URL Patterns'|t('link-audit'),
        instructions: 'Each row is a regular expression tested against the whole URL.'|t('link-audit')
            ~ ' <span class="info">' ~ 'Anything that matches is never checked, and is reported as ignored rather than broken. Examples: <code>^https://staging\\.</code>, <code>/preview\\?</code>.'|t('link-audit') ~ '</span>',
        id: 'ignorePatterns',
        name: 'settings[ignorePatterns]',
        cols: {
            enabled: { type: 'lightswitch', heading: 'On'|t('link-audit'), thin: true },
            pattern: {
                type: 'singleline',
                heading: 'URL Pattern'|t('link-audit'),
                info: 'A regular expression, tested against the whole URL, scheme and all.'|t('link-audit')
                    ~ "\n\n" ~ '`^https://staging\\.` matches everything on a staging subdomain.'|t('link-audit')
                    ~ "\n\n" ~ '`/preview\\?` matches any preview query.'|t('link-audit')
                    ~ "\n\n" ~ '`\\.pdf$` matches every PDF.'|t('link-audit'),
                code: true,
            },
            note: { type: 'singleline', heading: 'Note'|t('link-audit') },
        },
        rows: settings.ignorePatterns,
        addRowLabel: 'Add a pattern'|t('link-audit'),
        warning: config.ignorePatterns is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
        allowAdd: not (config.ignorePatterns is defined),
        allowDelete: not (config.ignorePatterns is defined),
        allowReorder: not (config.ignorePatterns is defined),
        static: config.ignorePatterns is defined,
    }) }}

    {{ forms.editableTableField({
        label: 'Ignored Hosts'|t('link-audit'),
        instructions: 'Whole domains nobody wants checked.'|t('link-audit')
            ~ ' <span class="info">' ~ 'A subdomain of a listed host counts as the host, so <code>example.com</code> covers <code>www.example.com</code> as well.'|t('link-audit') ~ '</span>',
        id: 'ignoreHosts',
        name: 'settings[ignoreHosts]',
        cols: {
            enabled: { type: 'lightswitch', heading: 'On'|t('link-audit'), thin: true },
            host: {
                type: 'singleline',
                heading: 'Host'|t('link-audit'),
                info: 'A bare domain, no scheme and no path: `example.com`, not `https://example.com/page`. Subdomains of it are covered as well.'|t('link-audit'),
                placeholder: 'example.com',
                code: true,
            },
            note: { type: 'singleline', heading: 'Note'|t('link-audit') },
        },
        rows: settings.ignoreHosts,
        addRowLabel: 'Add a host'|t('link-audit'),
        warning: config.ignoreHosts is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
        allowAdd: not (config.ignoreHosts is defined),
        allowDelete: not (config.ignoreHosts is defined),
        allowReorder: not (config.ignoreHosts is defined),
        static: config.ignoreHosts is defined,
    }) }}

    <hr>

    {{ forms.editableTableField({
        label: 'Extra Bot-Hostile Hosts'|t('link-audit'),
        instructions: 'Hosts you know refuse automated requests. Hosts only here, one per row: every value in the row is read as a host name.'|t('link-audit')
            ~ ' <span class="info">' ~ 'The plugin already knows the usual suspects; these are added to that list. A refusal from one of them is reported as unverifiable rather than broken, and is never counted against you, because a link nobody can check is not the same as a link that is gone.'|t('link-audit') ~ '</span>',
        id: 'botHostileHosts',
        name: 'settings[botHostileHosts]',
        cols: {
            host: {
                type: 'singleline',
                heading: 'Host'|t('link-audit'),
                info: 'A bare domain, no scheme and no path: `example.com`, not `https://example.com/page`. Subdomains of it are covered as well.'|t('link-audit'),
                placeholder: 'example.com',
                code: true,
            },
        },
        rows: settings.botHostileHosts,
        addRowLabel: 'Add a host'|t('link-audit'),
        warning: config.botHostileHosts is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
        allowAdd: not (config.botHostileHosts is defined),
        allowDelete: not (config.botHostileHosts is defined),
        allowReorder: not (config.botHostileHosts is defined),
        static: config.botHostileHosts is defined,
    }) }}
{% endblock %}
