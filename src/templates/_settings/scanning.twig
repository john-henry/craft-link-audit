{% extends 'link-audit/_settings/layout' %}

{% import '_includes/forms.twig' as forms %}

{% block settingsFields %}
    {% set elementTypeChoices = [] %}
    {% for class, label in elementTypeOptions %}
        {% set elementTypeChoices = elementTypeChoices|merge([{ label: label, value: class }]) %}
    {% endfor %}

    {% if elementTypeChoices|length %}
        {{ forms.checkboxSelectField({
            label: 'Scanned Element Types'|t('link-audit'),
            instructions: 'Tick what a scan should read. Out of the box that is entries, categories, tags and global sets, plus Commerce products and variants. Everything else stays out until you tick it here, orders and users included: there are an awful lot of them and no editor ever typed a link into one. Untick the lot and a scan reads nothing at all.'|t('link-audit'),
            id: 'scannedElementTypes',
            name: 'settings[scannedElementTypes]',
            options: elementTypeChoices,
            values: scannedElementTypes,
            warning: config.scannedElementTypes is defined ? 'Set in config/link-audit.php, so this is what is used no matter what is saved here.'|t('link-audit'),
            disabled: readOnly or config.scannedElementTypes is defined,
        }) }}
    {% endif %}

    {{ forms.lightswitchField({
        label: 'Scan On Element Save'|t('link-audit'),
        instructions: 'Pull the links out of an element again every time somebody saves it, so a link pasted in this morning is on the report without waiting for the next full scan. A link to one of your own pages an element or a route answers for is settled there and then. Anything that has to be asked for over the wire is left waiting for the next check, since a save is no time to be firing off requests. Bulk resaves and drafts are left alone.'|t('link-audit'),
        id: 'scanOnSave',
        name: 'settings[scanOnSave]',
        on: settings.scanOnSave,
        errors: settings.getErrors('scanOnSave'),
        warning: config.scanOnSave is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
        disabled: readOnly or config.scanOnSave is defined,
    }) }}

    {{ forms.lightswitchField({
        label: 'Check Internal Links'|t('link-audit'),
        instructions: 'Check the links that point at your own sites. A link to a page one of your elements or routes answers for is settled out of the database rather than over HTTP, because asking your own server about a page it just rendered is a request paid for twice. Anything the database cannot account for is asked for over HTTP like any other link, so a redirect rule, a rewrite or a file gets an honest answer instead of being called broken. Turn this off and links to your own sites are left out of the reports altogether.'|t('link-audit'),
        id: 'checkInternalLinks',
        name: 'settings[checkInternalLinks]',
        on: settings.checkInternalLinks,
        errors: settings.getErrors('checkInternalLinks'),
        warning: config.checkInternalLinks is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
        disabled: readOnly or config.checkInternalLinks is defined,
    }) }}

    {{ forms.lightswitchField({
        label: 'Check Image Sources'|t('link-audit'),
        instructions: 'Include the images found in rich text. A missing image is as broken as a missing page, and nobody notices it in the content editor.'|t('link-audit'),
        id: 'checkImages',
        name: 'settings[checkImages]',
        on: settings.checkImages,
        errors: settings.getErrors('checkImages'),
        warning: config.checkImages is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
        disabled: readOnly or config.checkImages is defined,
    }) }}

    {{ forms.lightswitchField({
        label: 'Check Iframe Sources'|t('link-audit'),
        instructions: 'Include embeds. Off by default, because the places people embed from block automated requests as a matter of course, and there is rarely much you can do about the answer.'|t('link-audit'),
        id: 'checkIframes',
        name: 'settings[checkIframes]',
        on: settings.checkIframes,
        errors: settings.getErrors('checkIframes'),
        warning: config.checkIframes is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
        disabled: readOnly or config.checkIframes is defined,
    }) }}

    {{ forms.lightswitchField({
        label: 'Scan Navigation Nodes'|t('link-audit'),
        instructions: 'Read the links in your navigations as well as the ones in your content. Worth leaving on: a nav link lives on the node rather than in anybody\'s entry, so nothing else in a scan ever sees it, which is why navigations quietly carry links nobody has checked in years.'|t('link-audit'),
        id: 'scanNavigationNodes',
        name: 'settings[scanNavigationNodes]',
        on: settings.scanNavigationNodes,
        errors: settings.getErrors('scanNavigationNodes'),
        warning: config.scanNavigationNodes is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
        disabled: readOnly or config.scanNavigationNodes is defined,
    }) }}

    {{ forms.lightswitchField({
        label: 'Crawl Rendered Pages'|t('link-audit'),
        instructions: 'Fetch each of your own pages over HTTP and read the links out of the HTML a visitor actually gets. This is the only way to catch what a template hard-codes: the footer, the main nav, the widget somebody dropped into a layout years ago. None of that is in anybody\'s content, so nothing else in a scan will ever see it. It costs one request per page against your own server, so keep the page cap sensible and leave this off if your site is very large or the server is tight.'|t('link-audit'),
        id: 'renderedCrawlEnabled',
        name: 'settings[renderedCrawlEnabled]',
        on: settings.renderedCrawlEnabled,
        errors: settings.getErrors('renderedCrawlEnabled'),
        toggle: 'la-crawl-options',
        warning: config.renderedCrawlEnabled is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
        disabled: readOnly or config.renderedCrawlEnabled is defined,
    }) }}

    <div id="la-crawl-options" class="{{ settings.renderedCrawlEnabled ? '' : 'hidden' }}" style="padding-left:24px">
        {{ forms.textField({
            label: 'Maximum Pages Per Crawl'|t('link-audit'),
            instructions: 'The ceiling on how many pages one crawl fetches. Pages are taken in a fixed order and whatever is left over is named in the log, so a crawl that stops short says so rather than quietly handing you a report that looks complete.'|t('link-audit'),
            id: 'maxPagesToCrawl',
            name: 'settings[maxPagesToCrawl]',
            value: settings.maxPagesToCrawl,
            type: 'number',
            min: 1,
            size: 8,
            errors: settings.getErrors('maxPagesToCrawl'),
            warning: config.maxPagesToCrawl is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
            disabled: readOnly or config.maxPagesToCrawl is defined,
        }) }}

        {{ forms.lightswitchField({
            label: 'Validate Anchor Fragments'|t('link-audit'),
            instructions: 'Check the bit after the hash as well as the address in front of it. A link to <code>/about#team</code> is only right if something on that page carries that id, and renaming a heading breaks every link pointing at it without anything else noticing. The target page is fetched to find out, so this rides on the crawl above and is off when that is.'|t('link-audit'),
            id: 'checkAnchorFragments',
            name: 'settings[checkAnchorFragments]',
            on: settings.checkAnchorFragments,
            errors: settings.getErrors('checkAnchorFragments'),
            warning: config.checkAnchorFragments is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
            disabled: readOnly or config.checkAnchorFragments is defined,
        }) }}
    </div>

    {{ forms.lightswitchField({
        label: 'Scan Relation Fields'|t('link-audit'),
        instructions: 'Record entries, assets and categories picked in relation fields too. Off by default, since Craft already guarantees the target row is there. Turn it on to catch a target that has been disabled or removed. A target with no URL of its own is not flagged, since a relation only picks an element, it never asserts the element renders a link.'|t('link-audit'),
        id: 'scanRelationFields',
        name: 'settings[scanRelationFields]',
        on: settings.scanRelationFields,
        errors: settings.getErrors('scanRelationFields'),
        warning: config.scanRelationFields is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
        disabled: readOnly or config.scanRelationFields is defined,
    }) }}

    {{ forms.lightswitchField({
        label: 'Scan Plain Text Fields'|t('link-audit'),
        instructions: 'Also read Plain Text fields and Table cells, and check anything in them that starts with http or https. Turn this on if your site keeps real link addresses in plain text fields, a Video URL field for instance. Off by default because an address typed into plain text is often just a note or an example, not a link a visitor can click, and checking those fills the report with things nobody can fix.'|t('link-audit'),
        id: 'scanPlainTextUrls',
        name: 'settings[scanPlainTextUrls]',
        on: settings.scanPlainTextUrls,
        errors: settings.getErrors('scanPlainTextUrls'),
        warning: config.scanPlainTextUrls is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
        disabled: readOnly or config.scanPlainTextUrls is defined,
    }) }}

    {{ forms.lightswitchField({
        label: 'Strip Tracking Parameters'|t('link-audit'),
        instructions: 'Take utm_source, fbclid, gclid and the rest off a URL before it is stored, so the same link shared with three campaign tags is one URL and one request rather than three.'|t('link-audit'),
        id: 'stripTrackingParams',
        name: 'settings[stripTrackingParams]',
        on: settings.stripTrackingParams,
        errors: settings.getErrors('stripTrackingParams'),
        warning: config.stripTrackingParams is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
        disabled: readOnly or config.stripTrackingParams is defined,
    }) }}

    <hr>

    {% set uriCols = {
        enabled: { type: 'lightswitch', heading: 'On'|t('link-audit'), thin: true },
    } %}
    {% if craft.app.isMultiSite %}
        {% set siteOptions = [{ value: '', label: 'All sites'|t('link-audit') }] %}
        {% for s in craft.app.sites.getAllSites() %}
            {% set siteOptions = siteOptions|merge([{ value: s.id, label: s.name }]) %}
        {% endfor %}
        {% set uriCols = uriCols|merge({
            siteId: { type: 'select', heading: 'Site'|t('link-audit'), options: siteOptions, thin: true },
        }) %}
    {% endif %}
    {% set uriCols = uriCols|merge({
        uriPattern: {
            type: 'singleline',
            heading: 'URI Pattern'|t('link-audit'),
            placeholder: 'Leave blank to match the homepage'|t('link-audit'),
            code: true,
        },
    }) %}

    {{ forms.editableTableField({
        label: 'Excluded URI Patterns'|t('link-audit'),
        instructions: 'Pages whose URI matches one of these regular expressions are left out of every scan. Handy for checkout, print views and anything else nobody is going to fix a link on. Examples: <code>^checkout</code>, <code>print$</code>, <code>^admin/</code>.'|t('link-audit'),
        id: 'excludedUriPatterns',
        name: 'settings[excludedUriPatterns]',
        cols: uriCols,
        rows: settings.excludedUriPatterns,
        addRowLabel: 'Add a URI pattern'|t('link-audit'),
        warning: config.excludedUriPatterns is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
        allowAdd: not (readOnly or config.excludedUriPatterns is defined),
        allowDelete: not (readOnly or config.excludedUriPatterns is defined),
        allowReorder: not (readOnly or config.excludedUriPatterns is defined),
        static: readOnly or config.excludedUriPatterns is defined,
    }) }}

    {% set sectionOptions = [] %}
    {% for section in craft.app.entries.getAllSections() %}
        {% set sectionOptions = sectionOptions|merge([{ value: section.uid, label: section.name }]) %}
    {% endfor %}

    {{ forms.checkboxSelectField({
        label: 'Excluded Sections'|t('link-audit'),
        instructions: 'Sections to leave out of the audit altogether. An excluded section is fenced both ways: its entries are never read for links, and a link or relation pointing at one of its entries is recorded as ignored rather than judged. Use it for a section whose entries are data a template reads rather than pages anybody visits, the case the URI patterns above cannot reach, since those entries have no URI to match.'|t('link-audit'),
        id: 'excludedSectionUids',
        name: 'settings[excludedSectionUids]',
        options: sectionOptions,
        values: settings.excludedSectionUids,
        warning: config.excludedSectionUids is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
        disabled: readOnly or config.excludedSectionUids is defined,
    }) }}

    {% set groupOptions = [] %}
    {% for group in craft.app.categories.getAllGroups() %}
        {% set groupOptions = groupOptions|merge([{ value: group.uid, label: group.name }]) %}
    {% endfor %}

    {% if groupOptions|length %}
        {{ forms.checkboxSelectField({
            label: 'Excluded Category Groups'|t('link-audit'),
            instructions: 'The same fence for taxonomy. A category group without its own pages is the usual way categories are built, and a link or relation pointing at one of its categories should not be reported broken for having no page.'|t('link-audit'),
            id: 'excludedCategoryGroupUids',
            name: 'settings[excludedCategoryGroupUids]',
            options: groupOptions,
            values: settings.excludedCategoryGroupUids,
            warning: config.excludedCategoryGroupUids is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
            disabled: readOnly or config.excludedCategoryGroupUids is defined,
        }) }}
    {% endif %}

    {{ forms.editableTableField({
        label: 'Always Valid Internal URLs'|t('link-audit'),
        instructions: 'Internal addresses that are fine even though nothing in the database answers to them: a route another plugin registers at runtime, a file the web server hands out itself, that sort of thing. Each row is a regular expression tested against the URI, so <code>^api/</code> covers everything under that path. A match is taken on trust and never asked for over HTTP, so this is also how you keep a scan away from a path that should not be requested at all.'|t('link-audit'),
        id: 'internalUrlAllowPatterns',
        name: 'settings[internalUrlAllowPatterns]',
        cols: {
            pattern: { type: 'singleline', heading: 'URI Pattern'|t('link-audit'), code: true },
            note: { type: 'singleline', heading: 'Note'|t('link-audit') },
        },
        rows: settings.internalUrlAllowPatterns,
        addRowLabel: 'Add a pattern'|t('link-audit'),
        warning: config.internalUrlAllowPatterns is defined ? 'Set in config/link-audit.php.'|t('link-audit'),
        allowAdd: not (readOnly or config.internalUrlAllowPatterns is defined),
        allowDelete: not (readOnly or config.internalUrlAllowPatterns is defined),
        allowReorder: not (readOnly or config.internalUrlAllowPatterns is defined),
        static: readOnly or config.internalUrlAllowPatterns is defined,
    }) }}
{% endblock %}
